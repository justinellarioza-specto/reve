# ── AI (Gemini) ─────────────────────────────────────────────
# Leave empty to use the built-in demo tutor (no AI calls).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# ── Supabase ────────────────────────────────────────────────
# Leave all three empty to run in demo mode (embedded Postgres in ./.data, single demo user).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres connection string from Supabase → Connect → "Transaction pooler" (port 6543)
DATABASE_URL=
# Needed only to store original uploads in Supabase Storage (bucket "uploads")
SUPABASE_SERVICE_ROLE_KEY=
